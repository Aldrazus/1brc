{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "displayName": "Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "enableMicrosoftCodeAnalysis": true,
          "enableClangTidyCodeAnalysis": true
        }
      }
    },
    {
      "name": "gcc",
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "common",
      "configurePreset": "common",
      "targets": [
        "all"
      ],
      "jobs": 8
    },
    {
      "name": "gcc-debug",
      "inherits": "common",
      "displayName": "Debug (gcc)",
      "configurePreset": "gcc",
      "configuration": "Debug"
    },
    {
      "name": "gcc-reldebug",
      "inherits": "common",
      "displayName": "Release Debug",
      "configurePreset": "gcc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "gcc-release",
      "inherits": "common",
      "displayName": "Release",
      "configurePreset": "gcc",
      "configuration": "Release"
    }
  ]
}
